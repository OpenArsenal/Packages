pkgname=ollama-cuda12
pkgver=0.34.2
pkgrel=1
pkgdesc='CUDA 12 backend for Ollama (Pascal-compatible)'
arch=(x86_64)
url='https://github.com/ollama/ollama'
license=(MIT)
options=('!lto')
depends=(
  "ollama=${pkgver}"
  cuda12
  glibc
  libgcc
  libstdc++
)
makedepends=(
  cmake
  ninja
  git
  gcc14
)
provides=("ollama-cuda=${pkgver}")
conflicts=('ollama-cuda' 'ollama-cuda13')
source=("git+${url}#tag=v${pkgver}")
b2sums=('80fe109351d3fcafb2065fb678ee51aca07f0786ca242e5800e579293b408234fb9a7c03f8b94f05ade9f62a7b549c3b8eb91ce777bbf131c2257f359b9d547a')

_build_dir='build/llama-server-cuda_v12'
_payload_dir='dist/lib/ollama/cuda_v12'

_require_cuda12() {
  if [[ ! -x '/opt/cuda/bin/nvcc' ]]; then
    printf '==> ERROR: %s\n' 'nvcc not found at /opt/cuda/bin/nvcc' >&2
    printf '==> ERROR: %s\n' 'Install cuda12 before building ollama-cuda12' >&2
    return 1
  fi

  local cuda_major
  cuda_major=$(/opt/cuda/bin/nvcc --version | sed -n 's/.*release \([0-9]*\)\..*/\1/p')
  printf '==> Detected CUDA version: %s at /opt/cuda\n' "${cuda_major}"

  if [[ "${cuda_major}" -ne 12 ]]; then
    printf '==> ERROR: ollama-cuda12 requires CUDA major version 12 (detected: %s)\n' "${cuda_major}" >&2
    return 1
  fi

  if ! command -v gcc-14 >/dev/null 2>&1 || ! command -v g++-14 >/dev/null 2>&1; then
    printf '==> ERROR: %s\n' 'CUDA 12 build requires gcc14 (gcc-14/g++-14)' >&2
    return 1
  fi
}

_assert_cuda_payload() {
  local payload="${srcdir}/ollama/${_payload_dir}"

  if [[ ! -f "${payload}/libggml-cuda.so" ]]; then
    printf '==> ERROR: missing CUDA 12 backend: %s\n' "${payload}/libggml-cuda.so" >&2
    return 1
  fi

  if readelf -d "${payload}/libggml-cuda.so" | grep -Fq "${srcdir}"; then
    printf '==> ERROR: CUDA 12 backend contains a build-tree runtime path\n' >&2
    return 1
  fi
}

build() {
  _require_cuda12

  local _path_flags=(
    "-ffile-prefix-map=${srcdir}=."
    "-fmacro-prefix-map=${srcdir}=."
    "-fdebug-prefix-map=${srcdir}=."
  )
  local _cuda_path_flags=(
    "-Xcompiler=-ffile-prefix-map=${srcdir}=."
    "-Xcompiler=-fmacro-prefix-map=${srcdir}=."
    "-Xcompiler=-fdebug-prefix-map=${srcdir}=."
  )

  export CFLAGS+=" ${_path_flags[*]}"
  export CXXFLAGS+=" ${_path_flags[*]}"
  export CPPFLAGS+=" ${_path_flags[*]}"

  export PATH="/opt/cuda/bin:${PATH}"
  export CUDA_PATH='/opt/cuda'
  export CUDAToolkit_ROOT='/opt/cuda'
  export LD_LIBRARY_PATH="/opt/cuda/lib64:${LD_LIBRARY_PATH:-}"
  export CC=gcc-14
  export CXX=g++-14
  export CUDAHOSTCXX=g++-14

  cd ollama
  rm -rf -- "${_build_dir}" dist

  cmake -S llama/server --preset llama_cuda_v12_linux \
    -D CMAKE_CUDA_HOST_COMPILER=/usr/bin/g++-14 \
    -D CMAKE_SKIP_RPATH=ON \
    -D CMAKE_SKIP_BUILD_RPATH=ON \
    -D CMAKE_BUILD_WITH_INSTALL_RPATH=OFF \
    -D CMAKE_INSTALL_RPATH='' \
    -D CMAKE_CUDA_FLAGS="-Wno-deprecated-gpu-targets -t 2 ${_cuda_path_flags[*]}"

  cmake --build "${_build_dir}"
  cmake --install "${_build_dir}" --component llama-server
  _assert_cuda_payload
}

package() {
  cd ollama
  _assert_cuda_payload

  install -dm755 "${pkgdir}/usr/lib/ollama"
  cp -a "${_payload_dir}" "${pkgdir}/usr/lib/ollama/"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
