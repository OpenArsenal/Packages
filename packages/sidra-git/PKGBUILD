pkgname=sidra-git
pkgver=0.3.5.r19.gead4931
pkgrel=1
pkgdesc='An elegant Apple Music desktop client for Linux - latest Git snapshot using CastLabs Electron 42'
arch=('x86_64')
url='https://github.com/wimpysworld/sidra'
license=('BlueOak-1.0.0')
depends=(
  'electron42-castlab'
  'hicolor-icon-theme'
)
makedepends=(
  'git'
  'imagemagick'
  'nodejs-lts-krypton'
  'npm'
)
optdepends=(
  'discord: Discord Rich Presence integration'
  'playerctl: command-line MPRIS control/testing'
)
provides=("sidra=${pkgver}")
conflicts=('sidra' 'sidra-bin')
source=('sidra::git+https://github.com/wimpysworld/sidra.git#branch=main')
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/sidra"

  local _describe _version _revision _commit
  if _describe="$(git describe --tags --long --abbrev=7 --match '[0-9]*' 2>/dev/null)"; then
    sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/; s/-/./g' <<< "${_describe}"
  else
    _version="$(node -p "require('./package.json').version")"
    _revision="$(git rev-list --count HEAD)"
    _commit="$(git rev-parse --short=7 HEAD)"
    printf '%s.r%s.g%s\n' "${_version}" "${_revision}" "${_commit}"
  fi
}

_install_hicolor_icons() {
  local _src="$1"
  local _size

  if [[ ! -f "${_src}" ]]; then
    printf 'Sidra icon source not found: %s\n' "${_src}" >&2
    return 1
  fi

  for _size in 16 22 24 32 48 64 128 256 512; do
    install -dm755 "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps"
    magick "${_src}" -resize "${_size}x${_size}" \
      "${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/sidra.png"
  done

  install -Dm644 "${pkgdir}/usr/share/icons/hicolor/512x512/apps/sidra.png" \
    "${pkgdir}/usr/share/pixmaps/sidra.png"
}

prepare() {
  cd "${srcdir}/sidra"

  # Sidra pins castLabs Electron through a public GitHub Git dependency.
  # npm 12 disables Git dependencies by default, so opt in explicitly.
  export npm_config_allow_git=all
  export npm_config_cache="${srcdir}/npm-cache"
  export GIT_TERMINAL_PROMPT=0

  # npm's lockfile resolves the public GitHub dependency to SSH. Rewrite all
  # common GitHub SSH/Git forms to HTTPS so clean chroots need no SSH key.
  export GIT_CONFIG_COUNT=4
  export GIT_CONFIG_KEY_0='url.https://github.com/.insteadOf'
  export GIT_CONFIG_VALUE_0='git@github.com:'
  export GIT_CONFIG_KEY_1='url.https://github.com/.insteadOf'
  export GIT_CONFIG_VALUE_1='ssh://git@github.com/'
  export GIT_CONFIG_KEY_2='url.https://github.com/.insteadOf'
  export GIT_CONFIG_VALUE_2='git+ssh://git@github.com/'
  export GIT_CONFIG_KEY_3='url.https://github.com/.insteadOf'
  export GIT_CONFIG_VALUE_3='git://github.com/'

  # The system electron42-castlab runtime is used for packaging and execution.
  # Keep the dependency's install script from downloading another Electron.
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1

  npm ci \
    --allow-git=all \
    --ignore-scripts \
    --no-audit \
    --no-fund
}

build() {
  cd "${srcdir}/sidra"

  npm run build

  # electron-builder creates the application ASAR using the installed castLabs
  # Electron 42 distribution instead of downloading or bundling another runtime.
  npx --no-install electron-builder --linux dir --x64 \
    --config.electronDist=/usr/lib/electron42-castlab \
    --config.directories.output=release-arch \
    --config.npmRebuild=false \
    --publish never
}

package() {
  local _resources="${srcdir}/sidra/release-arch/linux-unpacked/resources"

  if [[ ! -f "${_resources}/app.asar" ]]; then
    printf 'Could not find the built Sidra app.asar at %s\n' "${_resources}" >&2
    return 1
  fi

  install -dm755 "${pkgdir}/usr/lib/sidra/resources"
  install -Dm644 "${_resources}/app.asar" \
    "${pkgdir}/usr/lib/sidra/resources/app.asar"

  if [[ -d "${_resources}/app.asar.unpacked" ]]; then
    cp -a "${_resources}/app.asar.unpacked" \
      "${pkgdir}/usr/lib/sidra/resources/"
  fi

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/sidra" <<'LAUNCHER'
#!/bin/sh
export SIDRA_DISABLE_AUTO_UPDATE=1
exec electron42-castlab --class=sidra --name=sidra /usr/lib/sidra/resources/app.asar "$@"
LAUNCHER

  _install_hicolor_icons "${srcdir}/sidra/build/icon.png"

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/sidra.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Sidra
Comment=An elegant Apple Music desktop client
Exec=sidra %U
Icon=sidra
Keywords=Apple;Music;Streaming;Audio;Player;Sidra;
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Music;
MimeType=x-scheme-handler/itms;
StartupNotify=true
StartupWMClass=sidra
DESKTOP

  install -Dm644 "${srcdir}/sidra/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
