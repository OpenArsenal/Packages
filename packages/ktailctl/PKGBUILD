pkgname=ktailctl
pkgver=0.22.3
pkgrel=1
_upstream_dir="KTailctl-$pkgver"

arch=(x86_64 aarch64)
url='https://github.com/f-koehler/KTailctl'
pkgdesc='GUI to monitor and manage Tailscale'
license=(
  GPL-3.0-or-later
  CC0-1.0
  FSFAP
  CC-BY-4.0
)

depends=(
  breeze-icons
  glibc
  hicolor-icon-theme
  kconfig
  kcoreaddons
  kdbusaddons
  kguiaddons
  ki18n
  kiconthemes
  kirigami
  kirigami-addons
  knotifications
  kwindowsystem
  libgcc
  libstdc++
  qqc2-desktop-style
  qt6-base
  qt6-declarative
  qt6-svg
  tailscale
)

optdepends=(
  'qt6-wayland: native Wayland platform plugin support'
)

makedepends=(
  cmake
  extra-cmake-modules
  go
)

checkdepends=(
  appstream
  desktop-file-utils
)

install=$pkgname.install

source=(
  # Stable package: use the release tag archive rather than a VCS source.
  #
  # We intentionally avoid git+$url.git#tag=v$pkgver?signed because that requires
  # users/builders to import and trust upstream's signing key locally. For this
  # package, the lower-friction path is to use explicit release artifacts with
  # checksums in the PKGBUILD.
  "$pkgname-$pkgver-tag.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"

  # Arch's Go guidance permits module downloads in prepare(), but this package is
  # better treated as a network-sensitive GUI wrapper around tailscaled. Upstream
  # publishes a vendored Go module snapshot for releases, and the wrapper build
  # already uses `-mod vendor`, so keep that dependency tree as an explicit,
  # checksummed source.
  #
  # This makes the exact Go dependency snapshot part of the package source
  # contract and avoids undeclared build-time network access.
  "ktailctl-wrapper-vendor-v$pkgver.tar.gz::$url/releases/download/v$pkgver/ktailctl-wrapper-vendor-v$pkgver.tar.gz"

  # Fix Kirigami navigation warnings and login-profile navigation.
  # Upstream: https://github.com/f-koehler/KTailctl/pull/630
  "kirigami-navigation-warnings.patch::https://github.com/ran-dall/KTailctl/commit/1bad83efc785c0523a2dc123b71324dfe4967fe0.patch"
)

sha256sums=('591931508ccc3ad1b122bd3c9dd3d43d7e4b616d44c559d36f110bd5bc0afe0c'
            '4890a1e32396e7e6468615b09f95827a3d5761807f4df59e95a6d30b5884860a'
            '5e89d7af8fc9dbdabde62ee0e49f12287a0846d5216105658c98badc131c8dcc')

_prepare_go_env() {
  # Keep all Go build state inside $srcdir. This avoids polluting the builder's
  # home directory and makes accidental dependency materialization easier to spot
  # in clean-chroot builds.
  export GOPATH="${srcdir}/.gopath"
  export GOCACHE="${srcdir}/.gocache"
  export GOMODCACHE="${srcdir}/.gomodcache"

  # Upstream's go.mod currently requests Go 1.26.4. `GOTOOLCHAIN=local` prevents
  # newer Go versions from downloading another toolchain behind makepkg's back.
  export GOTOOLCHAIN=local

  # The wrapper is a c-archive linked into the Qt/KDE application, so keep CGO
  # enabled and pass Arch's hardening flags through in build().
  export CGO_ENABLED=1

  # Release tag archives are not Git checkouts. Disabling build VCS stamping
  # prevents Go from trying to inspect unavailable VCS metadata.
  export GOFLAGS="-buildvcs=false"
}

_check_go_toolchain() {
  local go_version_text
  local go_version
  local version
  local major
  local minor
  local patch

  go_version_text="$(go version 2>/dev/null || true)"
  go_version="$(go env GOVERSION 2>/dev/null || true)"

  if [[ -z "$go_version_text" || -z "$go_version" ]]; then
    error "failed to query the Go toolchain"
    return 1
  fi

  # KTailctl's wrapper uses the standard Go toolchain. gcc-go/gccgo has already
  # caused confusing AUR build failures with go.mod version parsing, e.g. rejecting
  # `go 1.26.4` as an invalid version. Fail early with a clear package-side error.
  if grep -qiE 'gccgo|gcc-go' <<< "$go_version_text"; then
    error "KTailctl does not build with gcc-go; install Arch's official go package"
    return 1
  fi

  # Upstream's wrapper go.mod currently requires Go 1.26.4. Accept newer official
  # Go releases, but reject older toolchains before CMake or Go fails with a less
  # useful go.mod parser error.
  version="${go_version#go}"
  IFS=. read -r major minor patch <<< "$version"

  if (( major < 1 || (major == 1 && minor < 26) )); then
    error "KTailctl requires Go 1.26 or newer; found $go_version"
    return 1
  fi
}

prepare() {
  cd "$_upstream_dir"
  _prepare_go_env
  _check_go_toolchain

  # Fix initial PageRow navigation and avoid Kirigami StackView anchor
  # warnings when opening and closing login profile details.
  patch -Np1 -i "$srcdir/kirigami-navigation-warnings.patch"

  # v0.22.x moved the Go wrapper from src/wrapper to src/tailscale/wrapper and
  # renamed the release vendor artifact from the older tailwrap form to
  # ktailctl-wrapper-vendor-v$pkgver.tar.gz.
  #
  # Reuse the declared vendored dependency snapshot rather than running
  # `go mod vendor` here and letting dependency materialization drift at build
  # time.
  rm -rf src/tailscale/wrapper/vendor
  bsdtar -xf "$srcdir/ktailctl-wrapper-vendor-v$pkgver.tar.gz" -C src/tailscale/wrapper

  # v0.22.1 is a patch release, but the tagged CMake project still declares
  # VERSION 0.22.0. The application uses the generated version header for
  # KAboutData, so leaving this unfixed makes the installed app report the wrong
  # version and complicates user bug reports.
  sed -i "s/VERSION 0\.22\.0/VERSION $pkgver/" CMakeLists.txt

  # GCC warns about Clang-only `-Wno-*compat` flags. Trim packaging warning noise
  # without changing runtime behavior.
  sed -i '/-Wno-c99-extensions \\/d; /-Wno-c++98-compat \\/d' CMakeLists.txt

  # QT_MESSAGELOGCONTEXT bakes source file paths into logging metadata via
  # context.file. Keep packaged builds reproducible by removing it from the
  # wrapper logging target.
  #
  # In 0.22.1 this define only appears on ktailctl_wrapper_logging. If upstream
  # adds it to more targets later, re-audit with:
  #   grep -R "QT_MESSAGELOGCONTEXT" -n .
  sed -i '/target_compile_definitions(ktailctl_wrapper_logging PRIVATE QT_MESSAGELOGCONTEXT)/d' \
    src/tailscale/wrapper/CMakeLists.txt
}

build() {
  cd "$_upstream_dir"
  _prepare_go_env
  _check_go_toolchain

  # CRITICAL: export CGO flags for the Go wrapper hardening path.
  #
  # KTailctl builds the Go wrapper as a c-archive and links it into the C++/Qt
  # application. Without these, the CGO objects may miss the hardening flags that
  # Arch normally applies to native code.
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"

  local cmake_options=(
    -B build
    -S .
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX=/usr

    # KDEInstallDirs owns this path. Setting the KDE variable avoids the warning
    # emitted when CMAKE_INSTALL_LIBDIR is overridden too early.
    -DKDE_INSTALL_LIBDIR=lib

    # v0.22.x adds a real CTest test suite. Enable it for package builds so the
    # rewritten property-list model, Tailscale status parsing, and utility logic
    # are exercised before packaging.
    -DKTAILCTL_ENABLE_TESTS=ON

    # Upstream added a CMake path that can download a Go toolchain from go.dev.
    # Arch packages must use declared system makedepends instead of fetching a
    # compiler during the build.
    -DKTAILCTL_FETCH_GO=OFF

    # Despite the name, this is currently the cleanest upstream switch for
    # networkless Go dependency handling. With this enabled, the wrapper CMake
    # assumes vendor/ is already present instead of running `go mod vendor`.
    #
    # Keep this under review on every upstream bump. If KTAILCTL_FLATPAK_BUILD
    # starts affecting runtime behavior or install layout, replace this with a
    # focused patch that disables only the vendoring command.
    -DKTAILCTL_FLATPAK_BUILD=ON

    -Wno-dev
  )

  cmake "${cmake_options[@]}"
  cmake --build build
}

check() {
  cd "$_upstream_dir"

  # The tests are Qt-based. Offscreen mode keeps clean-chroot checks independent
  # of a running display server.
  export QT_QPA_PLATFORM=offscreen

  # Run upstream's test suite. This matters more in 0.22.x than in 0.21.x because
  # the release is built on a rewritten backend and property-list model.
  ctest --test-dir build --output-on-failure

  # Validate installed desktop/appstream metadata early. KTailctl is a GUI app,
  # so broken desktop metadata is a package bug, not cosmetic noise.
  desktop-file-validate org.fkoehler.KTailctl.desktop
  appstreamcli validate --no-net org.fkoehler.KTailctl.metainfo.xml
}

package() {
  cd "$_upstream_dir"

  DESTDIR="$pkgdir" cmake --install build

  # Upstream installs the Go c-archive under /usr/lib. The final ktailctl binary
  # links against it during the build; it is not normally a runtime library users
  # should link against.
  #
  # Keep this removal only after verifying with:
  #   ldd "$pkgdir/usr/bin/ktailctl"
  #   readelf -d "$pkgdir/usr/bin/ktailctl"
  #
  # If a future upstream release turns the wrapper into a real shared runtime
  # library, remove this cleanup.
  rm -f "$pkgdir/usr/lib/libktailctl_wrapper.a"

  # LICENSE.txt is GPL-3.0 text. The appstream metadata and desktop metadata also
  # carry SPDX identifiers, and the bundled country flags carry their own
  # CC-BY-4.0 license. Install the extra flag license explicitly so the package
  # does not hide bundled asset licensing behind the main project license.
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/icons/country-flags/LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.country-flags"
}
