_browser=vivaldi
pkgname=${_browser}-ffmpeg
_ffmpeg_pkgver=8.1.3
# Keep the Arch Chromium patch pinned across FFmpeg 8.1 point releases.
_chromium_patch_version=8.1.1
_vivaldi_major_version=8.3
pkgrel=1
pkgdesc="Additional support for proprietary codecs for ${_browser}"
arch=('x86_64')
url=https://ffmpeg.org/
_chromium_ffmpeg_url=https://chromium.googlesource.com/chromium/third_party/ffmpeg
license=('LGPL-2.1-or-later')
_so=libffmpeg.so

# Chromium 156.0.8078.110 third_party/ffmpeg submodule commit.
# Use update-ffmpeg-ref.sh when updating _chromium_version, then run updpkgsums.
_chromium_version=156.0.8078.110
_chromium_ffmpeg_ref=9db86ce5b5b454dfc96c435f9f0723012980c37f

pkgver=${_ffmpeg_pkgver}_${_chromium_version}_${_vivaldi_major_version}

source=(
  "${url}releases/ffmpeg-${_ffmpeg_pkgver}.tar.xz"
  "sigs-${_chromium_ffmpeg_ref}.base64::${_chromium_ffmpeg_url}/+/${_chromium_ffmpeg_ref}/chromium/ffmpeg.sigs?format=TEXT"
  "chromium-dts-${_chromium_patch_version}.patch::https://gitlab.archlinux.org/archlinux/packaging/packages/ffmpeg/-/raw/2-${_chromium_patch_version}-1/0001-Add-av_stream_get_first_dts-for-Chromium.patch"
)

sha256sums=('7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3'
            '0b5cb2ff097869916b6d050c81e278985c9ad752fabcf2f9f39487574709b853'
            'f865d677f8ad39c79dde69186629cb6468c2b289c4156dbb8dec8e68b0131b40')
b2sums=('30af91ac3585f1e5afe8cd42e1f2a5b818fea1e27e70cdfa7f3c3f92607274780fa0d453bd510f19e0d20c87bdac4714736ca74685cc7e13af015695976b1ec1'
        '046f7fcb32ccd2d18a8a85a6ef4e1445cb6af682fb75999b12b60cd900fc4d37962dd86fc3f0201ec23ba296a834a01139ba379fabb33b1b49fa331a876593d5'
        'e5f7b79f7731be9ee5a7280a9221fb531ac5a2d9820fc5870b68b0eabea667dfbe8f39f41c1e1763a4c84982896afaa54c81ff57847d203b70afafd726689e5d')

depends=(glibc)
makedepends=(nasm)
provides=("vivaldi-ffmpeg-codecs=${_chromium_version}")
conflicts=('vivaldi-ffmpeg-codecs')
options=('!lto')

prepare() {
  # List used functions from Chromium's ffmpeg.sigs for the selected Chromium tag.
  base64 -d "sigs-${_chromium_ffmpeg_ref}.base64" |
    grep -oP '\bav[a-z0-9_]*(?=\s*\()' |
    sort -u >sigs.txt

  sort -u -o sigs.txt sigs.txt

  {
    printf '{\nglobal:\n'
    sed 's/$/;/' sigs.txt
    printf 'local:\n*;\n};\n'
  } >export.map

  cd "ffmpeg-${_ffmpeg_pkgver}"

  # Use native opus not in kAllowedAudioCodecs.
  sed -i.bak 's/^ *\.p\.name *=.*/.p.name="libopus",/' libavcodec/opus/dec.c

  # Chromium patches.
  patch -Np1 -i "../chromium-dts-${_chromium_patch_version}.patch" || return 1
  sed -i.bak '/ff_aom_uninit_film_grain_params/d' libavcodec/h2645_sei.c
  sed -i.bak -E \
    -e '/&ff_dirac_codec,/d' \
    -e '/&ff_speex_codec,/d' \
    -e '/&ff_theora_codec,/d' \
    -e '/&ff_celt_codec,/d' \
    -e '/&ff_old_dirac_codec,/d' \
    libavformat/oggdec.c
  sed -i.bak 's/^int av_sscanf(.*/#define av_sscanf sscanf/' libavutil/avstring.h

  # CHROMIUM_NO_LOGGING.
  _av_log=$(grep -m1 -E '^void[[:space:]]+av_log\(' libavutil/log.c)
  _av_log_once=$(grep -m1 -E '^void[[:space:]]+av_log_once\(' libavutil/log.c)
  _av_vlog=$(grep -m1 -E '^void[[:space:]]+av_vlog\(' libavutil/log.c)

  sed -i.bak -E \
    '/^void[[:space:]]+(av_log|av_log_once|av_vlog)[[:space:]]*\(.*\)[[:space:]]*$/,/^[[:space:]]*}[[:space:]]*$/d' \
    libavutil/log.c

  printf '%s{}\n%s{}\n%s{}\n' \
    "${_av_log}" \
    "${_av_log_once}" \
    "${_av_vlog}" >>libavutil/log.c
}

build() {
  cd "ffmpeg-${_ffmpeg_pkgver}"

  ./configure \
    --disable-{debug,all,autodetect,doc,iconv,network,symver,large-tests} \
    --disable-{error-resilience,faan,iamf} \
    --enable-static \
    --disable-shared \
    --enable-av{format,codec,util} \
    --enable-swresample \
    --enable-demuxers \
    --enable-decoders \
    --enable-parsers \
    --extra-cflags="-fno-math-errno -fno-signed-zeros -fno-semantic-interposition -fomit-frame-pointer" \
    --enable-{pic,asm,hardcoded-tables} \
    --libdir=/

  make DESTDIR=.. install

  cd ..
  _symbols=$(sed 's/^/-Wl,-u,/' sigs.txt | paste -sd ' ' -)

  gcc -shared $LDFLAGS \
    -Wl,--start-group libav{codec,format,util}.a libswresample.a -Wl,--end-group \
    ${_symbols} \
    -Wl,--version-script=export.map \
    -lm \
    -Wl,-Bsymbolic \
    -o "${_so}"
}

package() {
  install -Dm755 "${_so}" "${pkgdir}/opt/${_browser}/${_so}.${_vivaldi_major_version}"
}
