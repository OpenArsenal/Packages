# Maintainer: (set your own maintainer line before AUR publication)
# OpenSpec: native standalone binary compiled from current upstream Git HEAD.
# Keep package layout and build logic aligned with openspec/PKGBUILD.

pkgname=openspec-git
pkgver=1.16.1.r0.g0fa4a970
pkgrel=1
pkgdesc='Spec-driven development for AI coding assistants (Git standalone CLI)'
arch=('x86_64' 'aarch64')
url='https://github.com/Fission-AI/OpenSpec'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++')
makedepends=('git' 'nodejs>=22.12.0' 'pnpm' 'bun')
provides=('openspec')
conflicts=('openspec' 'openspec-bin')
# Bun executables embed data after the ELF image; stripping may corrupt them.
options=('!strip' '!debug')

source=("OpenSpec::git+${url}.git")
sha256sums=('SKIP') # Tracking HEAD: VCS sources must remain unpinned.

pkgver() {
  cd "${srcdir}/OpenSpec"
  # e.g. v1.16.1-4-gabcdef12 -> 1.16.1.r4.gabcdef12
  git describe --long --tags --match='v[0-9]*' --abbrev=8 \
    | sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/'
}

prepare() {
  cd "${srcdir}/OpenSpec"

  export CI=1
  export PNPM_HOME="${srcdir}/.pnpm-home"
  pnpm install --frozen-lockfile --ignore-scripts --prod=false \
    --store-dir "${srcdir}/.pnpm-store"
}

build() {
  cd "${srcdir}/OpenSpec"
  export PNPM_HOME="${srcdir}/.pnpm-home"

  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
    *) printf 'Unsupported architecture: %s\n' "${CARCH}" >&2; return 1 ;;
  esac

  pnpm run build
  bun scripts/binary/build.mjs "${_target}"

  local _exe="${srcdir}/OpenSpec/dist-bin/openspec-${_target}"
  install -d "${srcdir}/completions"
  export OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1 CI=1 NO_COLOR=1
  local _shell
  for _shell in bash fish zsh; do
    "${_exe}" completion generate "${_shell}" \
      > "${srcdir}/completions/openspec.${_shell}"
  done
}

check() {
  cd "${srcdir}/OpenSpec"
  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
  esac
  local _exe="${srcdir}/OpenSpec/dist-bin/openspec-${_target}"
  export OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1 CI=1 NO_COLOR=1

  # Git package versions carry commit metadata; the CLI prints package.json's
  # plain upstream semver instead.
  local _upstream_ver
  _upstream_ver="$(node -p 'require("./package.json").version')"
  [[ "$("${_exe}" --version)" == "${_upstream_ver}" ]]
  "${_exe}" --help > /dev/null
  local _shell
  for _shell in bash fish zsh; do
    [[ -s "${srcdir}/completions/openspec.${_shell}" ]]
  done
}

package() {
  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
  esac

  install -Dm755 "${srcdir}/OpenSpec/dist-bin/openspec-${_target}" \
    "${pkgdir}/usr/bin/openspec"
  install -Dm644 "${srcdir}/OpenSpec/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm644 "${srcdir}/completions/openspec.bash" \
    "${pkgdir}/usr/share/bash-completion/completions/openspec"
  install -Dm644 "${srcdir}/completions/openspec.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/openspec.fish"
  install -Dm644 "${srcdir}/completions/openspec.zsh" \
    "${pkgdir}/usr/share/zsh/site-functions/_openspec"
}
