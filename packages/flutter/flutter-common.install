pre_install() {
  # /opt/flutter might be a separately installed or locally modified SDK.
  # Package install hooks must not erase files that pacman does not own.
  if [ -d "/opt/flutter" ]; then
    printf '%s\n' 'Notice: Existing Flutter SDK found at /opt/flutter; leaving it untouched.'
    printf '%s\n' 'If migration is needed, back up and move it manually after reviewing its contents.'
  fi

  if [ -d "/usr/lib/flutter/.git" ]; then
    printf '%s\n' 'Notice: Existing Flutter Git metadata found in /usr/lib/flutter/.git; leaving it untouched.'
    printf '%s\n' 'Review and migrate this directory manually if it belongs to an older SDK.'
  fi
}

post_install() {
  # The legacy flutterusers group might still contain user memberships or be
  # managed by an administrator. Do not delete it from a package hook.
  if grep -q '^flutterusers:' /etc/group; then
    printf '%s\n' 'Notice: Legacy flutterusers group exists; it has not been removed.'
    printf '%s\n' 'Review group memberships before retiring it manually.'
  fi
}
