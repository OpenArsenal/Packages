pre_install() {
  # /opt/flutter might be a separately installed or locally modified SDK.
  # Package install hooks must not erase files that pacman does not own.
  if [ -d "/opt/flutter" ]; then
    printf '%s\n' 'Notice: Existing Flutter SDK found at /opt/flutter; leaving it untouched.'
    printf '%s\n' 'If migration is needed, back up and move it manually after reviewing its contents.'
  fi

  if [ -d "/usr/lib/flutter/.git" ]; then
    echo "Removing unwanted git-refs in /usr/lib/flutter/.git."
    rm -rf "/usr/lib/flutter/.git"
  fi
}

post_install() {
  NEW=$1
  OLD=$2

  MAJOR=$(echo $OLD | awk -F '.' '{print $1}')
  MINOR=$(echo $OLD | awk -F '.' '{print $2}')
  PATCH=$(echo $OLD | awk -F '+' '{print $1}' | awk -F '.' '{print $3}')

  #if [[ $MAJOR == 3 && $MINOR -lt 8 ]]; then
    if grep -q "flutterusers" /etc/group; then
      echo "Removing group flutterusers as no longer needed."
      groupdel "flutterusers"
    fi
  #fi
}

