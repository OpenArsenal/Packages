pkgname=fontreal-git
pkgver=3.0.0.r3.g593ffaf
pkgrel=1
pkgdesc='Pixel-aligned font rendering for Qt 6 and Plasma (Git version)'
arch=('x86_64')
url='https://github.com/calculatetech/fontreal'
license=('MIT')
depends=('gcc-libs' 'glibc' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'fontconfig' 'freetype2')
makedepends=('binutils' 'git' 'pkgconf' 'qt6-shadertools' 'xxd')
provides=("fontreal=${pkgver}")
conflicts=('fontreal')
options=('!strip' '!debug')
install=fontreal-git.install

source=("fontreal::git+${url}.git#branch=main")
sha256sums=('SKIP')

_source_dir=fontreal

pkgver() {
  cd "${srcdir}/${_source_dir}"

  local _describe
  if _describe=$(git describe --long --tags --match 'v[0-9]*' --abbrev=7 2>/dev/null); then
    _describe=${_describe#v}
    sed -E 's/-([0-9]+)-g([0-9a-f]+)$/.r\1.g\2/; s/-/./g' <<< "${_describe}"
  else
    printf 'r%s.g%s\n' \
      "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

_provider_dir() {
  local _providers=("${srcdir}/fontreal-providers/"*)
  if (( ${#_providers[@]} != 1 )) || [[ ! -d ${_providers[0]} ]]; then
    printf 'Expected exactly one Qt provider directory\n' >&2
    return 1
  fi
  printf '%s\n' "${_providers[0]}"
}

_build_loader() {
  local _provider=$1
  local _name=$2
  shift 2

  local _loader_dir="${srcdir}/fontreal-loaders"
  local _src="${srcdir}/${_source_dir}/integrations/qt-stock"
  local _note="${_loader_dir}/${_name}.note"

  # Each Qt loader must advertise its own provider's plugin metadata.
  rm -f "${_note}"
  objcopy \
    --dump-section ".note.qt.metadata=${_note}" \
    "${_provider}/${_name}" \
    "${_loader_dir}/${_name}.copy"
  [[ -s ${_note} ]] || return 1

  cc -O2 -fPIC -shared -fvisibility=hidden \
    -I "${_loader_dir}" \
    "-DFONTREAL_METADATA=\"${_note}\"" \
    "-DMETADATA_SIZE=$(stat -c %s "${_note}")" \
    "-DPROVIDER_FILE=\"${_name}\"" \
    "$@" "${_src}/loader.c" "${_src}/metadata.S" -ldl \
    -o "${_loader_dir}/${_name}"
}

build() {
  cd "${srcdir}/${_source_dir}"
  tools/build-qt-stock-helper.sh "${srcdir}/fontreal-providers"

  local _provider _key _gui_id _quick_id
  local _loader_dir="${srcdir}/fontreal-loaders"
  _provider="$(_provider_dir)" || return 1
  _key=${_provider##*/}

  if [[ ! ${_key} =~ ^([0-9a-f]{40})-([0-9a-f]{40})$ ]]; then
    printf 'Invalid Qt provider identifier: %s\n' "${_key}" >&2
    return 1
  fi
  _gui_id=${BASH_REMATCH[1]}
  _quick_id=${BASH_REMATCH[2]}

  mkdir -p "${_loader_dir}"
  printf '    {{%s}, {%s}, "%s"},\n' \
    "$(sed -E 's/(..)/0x\1,/g' <<< "${_gui_id}")" \
    "$(sed -E 's/(..)/0x\1,/g' <<< "${_quick_id}")" \
    "${_key}" > "${_loader_dir}/providers.inc"

  _build_loader "${_provider}" libfontreal-cached-probe.so
  _build_loader "${_provider}" libfontreal_quick_default_probe.so -DFONTREAL_QUICK_LOADER
}

package() {
  local _provider _key
  local _plugins="${pkgdir}/usr/lib/fontreal/qt6/plugins/generic"
  local _loaders="${srcdir}/fontreal-loaders"
  local _source="${srcdir}/${_source_dir}"

  _provider="$(_provider_dir)" || return 1
  _key=${_provider##*/}

  install -Dm644 "${_loaders}/libfontreal-cached-probe.so" \
    "${_plugins}/libfontreal-cached-probe.so"
  install -Dm644 "${_loaders}/libfontreal_quick_default_probe.so" \
    "${_plugins}/libfontreal_quick_default_probe.so"
  install -Dm644 "${_provider}/libfontreal-cached-probe.so" \
    "${_plugins}/providers/${_key}/libfontreal-cached-probe.so"
  install -Dm644 "${_provider}/libfontreal_quick_default_probe.so" \
    "${_plugins}/providers/${_key}/libfontreal_quick_default_probe.so"

  install -Dm644 "${_source}/integrations/qt-stock/plasma-env.sh" \
    "${pkgdir}/etc/xdg/plasma-workspace/env/fontreal.sh"
  install -Dm644 "${_source}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_source}/THIRD_PARTY_NOTICES.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/THIRD_PARTY_NOTICES.md"
}
