pkgname=ryubing-git
pkgver=1.3.3.r302.gb23673271
pkgrel=1
pkgdesc='Experimental Nintendo Switch emulator written in C# (Ryubing fork of Ryujinx, git build)'
arch=('x86_64' 'aarch64')
url='https://ryujinx.app'
license=('MIT')

depends=(
  'dotnet-runtime'
  'ffmpeg'
  'glew'
  'gtk3'
  'libgdiplus'
  'libgl'
  'libice'
  'libsm'
  'libx11'
  'libxcursor'
  'libxext'
  'libxi'
  'libxrandr'
  'openal'
  'libpulse'
  'sdl2'
  'sdl2_mixer'
  'sndio'
  'systemd-libs'
  'vulkan-icd-loader'
)

makedepends=(
  'dotnet-sdk'
  'git'
)

optdepends=(
  'vulkan-driver: Vulkan GPU driver, e.g. vulkan-radeon, vulkan-intel, nvidia-utils'
)

provides=('ryubing' 'ryujinx')
conflicts=('ryubing' 'ryujinx' 'ryujinx-git')
options=('!strip')

_pkgsrc='ryubing'
source=("${_pkgsrc}::git+https://git.ryujinx.app/ryubing/ryujinx.git")
sha256sums=('SKIP')
b2sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgsrc"

  git describe --long --tags --match '[0-9]*' 2>/dev/null |
    sed -E 's/^v//; s/([^-]*-g)/r\1/; s/-/./g' ||
    printf '0.r%s.g%s' \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short HEAD)"
}

_get_runtime() {
  case "$CARCH" in
  x86_64) echo 'linux-x64' ;;
  aarch64) echo 'linux-arm64' ;;
  *)
    echo "Unsupported architecture: $CARCH" >&2
    return 1
    ;;
  esac
}

prepare() {
  cd "$srcdir/$_pkgsrc"

  # Harmless guard in case stale migration-era NuGet feeds appear again.
  if [[ -f nuget.config ]]; then
    sed -i \
      -e 's#https://git.ryujinx.app/api/v4/projects/17/packages/nuget/index.json#https://git.ryujinx.app/api/packages/projects/nuget/index.json#g' \
      -e '/<add key="Ryujinx.UpdateClient"/d' \
      nuget.config

    sed -i \
      '/<packageSource key="Ryujinx.UpdateClient">/,/<\/packageSource>/d' \
      nuget.config
  fi

  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  export DOTNET_CLI_HOME="$srcdir/dotnet-home"
  export NUGET_PACKAGES="$srcdir/nuget"

  dotnet restore "src/Ryujinx/Ryujinx.csproj" \
    -r "$(_get_runtime)" \
    -p:NuGetAudit=false
}

build() {
  cd "$srcdir/$_pkgsrc"

  export DOTNET_CLI_TELEMETRY_OPTOUT=1
  export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
  export DOTNET_CLI_HOME="$srcdir/dotnet-home"
  export NUGET_PACKAGES="$srcdir/nuget"

  dotnet publish "src/Ryujinx/Ryujinx.csproj" \
    -c Release \
    -r "$(_get_runtime)" \
    --self-contained false \
    --no-restore \
    -o "$srcdir/publish" \
    -p:DebugType=embedded \
    -p:NuGetAudit=false \
    -p:ExtraDefineConstants=DISABLE_UPDATER%2CFORCE_EXTERNAL_BASE_DIR

  dotnet build-server shutdown
}

package() {
  cd "$srcdir/$_pkgsrc" 2>/dev/null || cd "$(_srcdir)"

  install -dm755 "$pkgdir/usr/lib/ryubing"
  cp -a "$srcdir/publish/." "$pkgdir/usr/lib/ryubing/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/ryubing" <<'EOF'
#!/bin/sh
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-x11}"

if [ -x /usr/lib/ryubing/Ryujinx ]; then
  exec /usr/lib/ryubing/Ryujinx "$@"
fi

exec dotnet /usr/lib/ryubing/Ryujinx.dll "$@"
EOF

  ln -s ryubing "$pkgdir/usr/bin/ryujinx"
  ln -s ryubing "$pkgdir/usr/bin/Ryujinx"

  # Icon: upstream has moved/removed the old distribution/misc/Logo.svg path
  # in some trees, so discover an icon if available and fall back to a simple
  # packaged SVG rather than failing the build.
  local _icon_svg
  _icon_svg="$(
    find . -type f \( \
      -iname 'Logo.svg' -o \
      -iname 'Ryujinx.svg' -o \
      -iname 'ryujinx.svg' -o \
      -iname '*Ryujinx*icon*.svg' -o \
      -iname '*logo*.svg' \
      \) -print -quit
  )"

  if [[ -n "$_icon_svg" ]]; then
    install -Dm644 "$_icon_svg" \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/ryubing.svg"
  else
    install -Dm644 /dev/stdin \
      "$pkgdir/usr/share/icons/hicolor/scalable/apps/ryubing.svg" <<'EOF'
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128">
  <rect width="128" height="128" rx="24" fill="#3b3b3b"/>
  <text x="64" y="82" text-anchor="middle" font-family="sans-serif" font-size="64" font-weight="700" fill="#ffffff">R</text>
</svg>
EOF
  fi

  # Desktop file: use upstream if present, otherwise generate one.
  local _desktop_file
  _desktop_file="$(
    find . -type f \( \
      -path '*/distribution/linux/Ryujinx.desktop' -o \
      -name 'Ryujinx.desktop' -o \
      -name '*.desktop' \
      \) -print -quit
  )"

  if [[ -n "$_desktop_file" ]]; then
    install -Dm644 "$_desktop_file" \
      "$pkgdir/usr/share/applications/ryubing.desktop"

    sed -i \
      -e 's/^Name=.*/Name=Ryubing/' \
      -e 's/^Exec=.*/Exec=ryubing %f/' \
      -e 's/^Icon=.*/Icon=ryubing/' \
      "$pkgdir/usr/share/applications/ryubing.desktop"
  else
    install -Dm644 /dev/stdin \
      "$pkgdir/usr/share/applications/ryubing.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Ryubing
Comment=Nintendo Switch emulator
Exec=ryubing %f
Icon=ryubing
Terminal=false
Categories=Game;Emulator;
MimeType=application/x-nx-nro;application/x-nx-nso;application/x-nx-nsp;application/x-nx-xci;
StartupWMClass=Ryujinx
EOF
  fi

  # MIME file: install if upstream still ships it, otherwise skip.
  local _mime_file
  _mime_file="$(
    find . -type f \( \
      -path '*/distribution/linux/mime/Ryujinx.xml' -o \
      -name 'Ryujinx.xml' \
      \) -print -quit
  )"

  if [[ -n "$_mime_file" ]]; then
    install -Dm644 "$_mime_file" \
      "$pkgdir/usr/share/mime/packages/ryubing.xml"
  fi

  if [[ -f LICENSE.txt ]]; then
    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  elif [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
