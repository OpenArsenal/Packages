pkgname=talosctl
pkgver=1.14.0
pkgrel=1
pkgdesc='CLI for Talos Linux, built from official Sidero Labs source'
arch=('x86_64')
url='https://github.com/siderolabs/talos'
license=('MPL-2.0')
depends=('ca-certificates')
makedepends=('git' 'go')
conflicts=('talosctl-bin')
options=('!lto')

source=("talos::git+https://github.com/siderolabs/talos.git#tag=v${pkgver}?signed")
sha256sums=('26a4b5d93c548456206287f4700b86d3c84c6c13cb2b48e6b8d2e0e0082caaf3')

# Sidero Labs/Talos release signing keys, matching Arch Linux packaging policy.

validpgpkeys=(
'DB997306E3102F11C4E8F5527B26396447AB6DFD'
'CC51116A94490FA6FB3C18EB2401FCAE863A06CA'
'15D5721F5F5BAF121495363EFE042E3D4085A811'
'4F8E31286D7997C9625C6F7B322C6F63F594CE7C'
'F2DCEFD8F9F4E29B16C8ABE4F16F84591E26D77F'
'8D5378C17C004BA4C1EDEB7E86EC2A4776B60B45'
)

_go_env() {
export GOTOOLCHAIN=local
export GO111MODULE=on
export GOMODCACHE="${srcdir}/gomodcache"
export GOCACHE="${srcdir}/gocache"
}

prepare() {
cd "${srcdir}/talos"
_go_env

go mod download
go mod verify

(
cd pkg/machinery
go mod download
go mod verify
)
}

build() {
cd "${srcdir}/talos"
_go_env

export CGO_ENABLED=0
export GOFLAGS='-trimpath -mod=readonly -modcacherw'

(
cd pkg/machinery
go generate -v ./version
)

go build -v -o "${srcdir}/talosctl" ./cmd/talosctl
}

check() {
"${srcdir}/talosctl" version --client >/dev/null
}

package() {
  install -Dm755 "${srcdir}/talosctl" "${pkgdir}/usr/bin/talosctl"
  install -Dm644 "${srcdir}/talos/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
