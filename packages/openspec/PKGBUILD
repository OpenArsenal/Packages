pkgname=openspec
pkgver=1.16.1
pkgrel=1
pkgdesc='Spec-driven development for AI coding assistants (source-built standalone CLI)'
arch=('x86_64' 'aarch64')
url='https://github.com/Fission-AI/OpenSpec'
license=('MIT')
depends=('glibc' 'libgcc' 'libstdc++')
makedepends=('nodejs>=22.12.0' 'pnpm' 'bun')
conflicts=('openspec-bin' 'openspec-git')
# Bun executables embed data after the ELF image; stripping may corrupt them.
options=('!strip' '!debug')

_srcname="OpenSpec-${pkgver}"
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('5829a3986f107b2ec5a826479bb0185fa7a16aaa4cc7a36260467902bc584605')
b2sums=('6533b4cbfb4748741a7edaf8f5df73082d1a9eaf3958ea2ccd6b92a3ceee74d9345341295f0d852f8fa8c6ed1755151c656dbfcead4977602f063fa8b9469a24')

prepare() {
  cd "${srcdir}/${_srcname}"

  # Fail instead of silently compiling a mismatched release.
  local _upstream_ver
  _upstream_ver="$(node -p 'require("./package.json").version')"
  if [[ "${_upstream_ver}" != "${pkgver}" ]]; then
    printf 'Expected OpenSpec %s, found %s\n' "${pkgver}" "${_upstream_ver}" >&2
    return 1
  fi

  # pnpm honors upstream's packageManager pin and frozen lockfile.
  # Cache all downloaded dependencies within makepkg's disposable build tree.
  export CI=1
  export PNPM_HOME="${srcdir}/.pnpm-home"
  pnpm install --frozen-lockfile --ignore-scripts --prod=false \
    --store-dir "${srcdir}/.pnpm-store"
}

build() {
  cd "${srcdir}/${_srcname}"
  export PNPM_HOME="${srcdir}/.pnpm-home"

  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
    *) printf 'Unsupported architecture: %s\n' "${CARCH}" >&2; return 1 ;;
  esac

  # Official build order: TypeScript -> Bun --compile, with schemas embedded.
  pnpm run build
  bun scripts/binary/build.mjs "${_target}"

  # Use the locally compiled standalone executable for shell completion output.
  local _exe="${srcdir}/${_srcname}/dist-bin/openspec-${_target}"
  install -d "${srcdir}/completions"
  export OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1 CI=1 NO_COLOR=1
  local _shell
  for _shell in bash fish zsh; do
    "${_exe}" completion generate "${_shell}" \
      > "${srcdir}/completions/openspec.${_shell}"
  done
}

check() {
  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
  esac
  local _exe="${srcdir}/${_srcname}/dist-bin/openspec-${_target}"
  export OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1 CI=1 NO_COLOR=1

  [[ "$("${_exe}" --version)" == "${pkgver}" ]]
  "${_exe}" --help > /dev/null
  local _shell
  for _shell in bash fish zsh; do
    [[ -s "${srcdir}/completions/openspec.${_shell}" ]]
  done
}

package() {
  local _target
  case "${CARCH}" in
    x86_64) _target='linux-x64' ;;
    aarch64) _target='linux-arm64' ;;
  esac

  install -Dm755 "${srcdir}/${_srcname}/dist-bin/openspec-${_target}" \
    "${pkgdir}/usr/bin/openspec"
  install -Dm644 "${srcdir}/${_srcname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -Dm644 "${srcdir}/completions/openspec.bash" \
    "${pkgdir}/usr/share/bash-completion/completions/openspec"
  install -Dm644 "${srcdir}/completions/openspec.fish" \
    "${pkgdir}/usr/share/fish/vendor_completions.d/openspec.fish"
  install -Dm644 "${srcdir}/completions/openspec.zsh" \
    "${pkgdir}/usr/share/zsh/site-functions/_openspec"
}
