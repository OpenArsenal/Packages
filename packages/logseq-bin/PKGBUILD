# Logseq 2.0.2 beta prebuilt ZIP package, x86_64 and aarch64.
pkgname=logseq-bin
pkgver=2.0.2
pkgrel=1
pkgdesc='Privacy-first knowledge management (prebuilt release; bundled Electron)'
arch=('x86_64' 'aarch64')
url='https://github.com/logseq/logseq'
license=('AGPL-3.0-or-later')
options=('!debug' '!strip')
install='logseq.install'
provides=("logseq=${pkgver}")
conflicts=('logseq' 'logseq-git' 'logseq-electron' 'logseq-electron-git')

depends=(
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'curl'
  'dbus'
  'expat'
  'glib2'
  'gtk3'
  'libcups'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'python'
  'systemd-libs'
  'zlib'
)
makedepends=('asar' 'libarchive')

source=('logseq.desktop' 'logseq-flags-wrapper.sh')
source_x86_64=(
  "logseq-x86_64-${pkgver}.zip::${url}/releases/download/${pkgver}/Logseq-linux-x86_64-${pkgver}.zip"
)
source_aarch64=(
  "logseq-aarch64-${pkgver}.zip::${url}/releases/download/${pkgver}/Logseq-linux-arm64-${pkgver}.zip"
)
# The ZIPs are explicitly extracted in prepare() to support either upstream
# root-level or parent-directory archive layouts.
noextract=("logseq-x86_64-${pkgver}.zip" "logseq-aarch64-${pkgver}.zip")

sha256sums=(
  'SKIP'
  'SKIP'
)
sha256sums_x86_64=(
  '289eadd4dfcbdd2ab71aeb6cf02a53d0b5d7340865c528b1434bef8001900a9a'
)
sha256sums_aarch64=(
  '9f0404ea59f5af58874ed51c9291bde0ebd2b0ae65fe3259abfc42d3188904d5'
)

prepare() {
  rm -rf "${srcdir}/logseq-bin-extract"
  install -d "${srcdir}/logseq-bin-extract"
  bsdtar -xf "${srcdir}/logseq-${CARCH}-${pkgver}.zip" \
    -C "${srcdir}/logseq-bin-extract"
}

package() {
  local _source_root="${srcdir}/logseq-bin-extract"
  local _install_root="${pkgdir}/opt/logseq"
  local _binary _app_exec='/opt/logseq/Logseq' _icon _electron_version
  # Builder ZIPs may have their executable at the archive root or below it.
  _binary="$(find "${_source_root}" -maxdepth 4 -type f \
      \( -name Logseq -o -name logseq \) -print -quit)"
  if [[ -z "${_binary}" ]]; then
    echo 'ERROR: no Logseq executable found in release ZIP' >&2
    return 1
  fi
  _source_root="${_binary%/*}"
  install -d "${_install_root}"
  cp -a "${_source_root}/." "${_install_root}/"

  _icon="${srcdir}/logseq-2.0.2-icon.png"
  if [[ -f "${_install_root}/resources/app/icons/logseq.png" ]]; then
    cp "${_install_root}/resources/app/icons/logseq.png" "${_icon}"
  elif [[ -f "${_install_root}/resources/app.asar" ]]; then
    asar extract-file "${_install_root}/resources/app.asar" \
      'icons/logseq.png' >"${_icon}"
  else
    echo 'ERROR: bundled Logseq icon not found' >&2
    return 1
  fi
  test -s "${_icon}"
  install -Dm644 "${_icon}" "${pkgdir}/usr/share/pixmaps/logseq.png"
  install -Dm644 "${srcdir}/logseq.desktop" \
    "${pkgdir}/usr/share/applications/logseq.desktop"

  if [[ -x "${_install_root}/logseq" ]]; then
    _app_exec='/opt/logseq/logseq'
  fi
  sed -e "s#@LOGSEQ_EXEC@#${_app_exec}#g" \
    "${srcdir}/logseq-flags-wrapper.sh" >"${srcdir}/logseq"
  if grep -qE '@[A-Z_]+@' "${srcdir}/logseq"; then
    echo 'ERROR: unresolved wrapper placeholder' >&2
    return 1
  fi
  install -Dm755 "${srcdir}/logseq" "${pkgdir}/usr/bin/logseq"

  _electron_version="$(strings "${pkgdir}${_app_exec}" | grep -Pom1 'Electron/[0-9.]+' || true)"
  _electron_version="${_electron_version#Electron/}"
  if [[ -n "${_electron_version}" ]]; then
    install -Dm644 /dev/stdin "${_install_root}/electron_version" \
      <<<"${_electron_version}"
  fi
  chmod -R u=rwX,go=rX "${pkgdir}"
}
