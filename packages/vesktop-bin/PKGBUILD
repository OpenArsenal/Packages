pkgname=vesktop-bin
pkgver=1.6.7
pkgrel=1
pkgdesc="Standalone Discord desktop app with Vencord (bundled Electron)"
arch=('x86_64' 'aarch64')
url="https://github.com/Vencord/Vesktop"
license=('GPL-3.0-or-later')
options=('!debug' '!strip')

_pkgname=Vesktop
_pkgsrc='opt/Vesktop'
_app_id='dev.vencord.Vesktop'

provides=("vesktop=${pkgver}")
conflicts=(
  'vesktop'
  'vesktop-git'
  'vesktop-electron'
  'vesktop-electron-git'
)
install='vesktop.install'

depends=(
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'dbus'
  'expat'
  'glib2'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
)

optdepends=(
  'pipewire-pulse: improved Linux system audio sharing support'
  'xdg-utils: set desktop and protocol handler associations on Linux'
  'speech-dispatcher: text-to-speech support on Linux'
)

source=(
  'vesktop.desktop'
  'vesktop-flags-wrapper.sh'
  "${_app_id}.metainfo.xml::${url}/releases/download/v${pkgver}/${_app_id}.metainfo.xml"
)
source_x86_64=(
  "vesktop-${pkgver}-x86_64.rpm::${url}/releases/download/v${pkgver}/vesktop-${pkgver}.x86_64.rpm"
)
source_aarch64=(
  "vesktop-${pkgver}-aarch64.rpm::${url}/releases/download/v${pkgver}/vesktop-${pkgver}.aarch64.rpm"
)

sha256sums=('c7734c79b1329161d57aabe851f8f346b24d02824a6081d8cfb8355945e61b1d'
            'a97a9dbef2fd14a6a931f78a1ddce5f6f50944971492104515fdce58c7fc55a5'
            '0344011df629920b49a95522b4fc716e16d289315bbea6e40aa4b7e6d73605f1')
sha256sums_x86_64=('0569c8a8956f161a28b82c6fba667e7ee6828df8856247f5c08f18c1b1b0b8fc')
sha256sums_aarch64=('642473098904feb424aafc0d97d33d20d8c2596186cdfc6e9866fa6bfc6d531d')
b2sums=('18f00fecda0f4293d6c4429f3590fadef1f212fe161327dffb5c3fbc436845f6b8a96d1557a5b120bca2e0c06e459849b0a2966f69c22000b90e7d087ceb1606'
        '10030f288016cd98672bd23628c54efeaac6a04d82fe5b72200441ae9e0708c26827a86729e4404f46ef7775766503b8067b48aef84b6631b08b17abf56e7a45'
        '59ed84a2c5363da89cda4f9a149ec79b3c2044b66ee93e469c221ad451580b020e7e468906f1426e0e4cb56bf054a2300027c79b425355a0a060e496a7033f6f')
b2sums_x86_64=('35cd6af8076dac9d82b3bd5939a3b89684b6816536d188508bedae2831004930d408f2ee46d22c002c37735a9ba0bc341d1cb148245f86e725f72d2a641732c7')
b2sums_aarch64=('4620aafb9ddd9d142c3b78b505f92edf5ec8602896fd600cb02367223608f450f24b4ef8f73cf325bac342cfaf2dc3817a4023accdf2b3af672a493dabc3b174')

package() {
  local _install_root="${pkgdir}/opt/vesktop"
  local _app_exec="/opt/vesktop/vesktop"
  local _electron_version=""
  local _file

  install -d "${_install_root}"
  cp -a "${srcdir}/${_pkgsrc}/." "${_install_root}/"
  rm -f "${_install_root}/resources/app-update.yml"

  install -Dm644 "${srcdir}/vesktop.desktop" \
    "${pkgdir}/usr/share/applications/${_app_id}.desktop"
  install -Dm644 "${srcdir}/${_app_id}.metainfo.xml" \
    "${pkgdir}/usr/share/metainfo/${_app_id}.metainfo.xml"

  if [[ -f "${srcdir}/usr/share/icons/hicolor/scalable/apps/vesktop.svg" ]]; then
    install -Dm644 "${srcdir}/usr/share/icons/hicolor/scalable/apps/vesktop.svg" \
      "${pkgdir}/usr/share/icons/hicolor/scalable/apps/vesktop.svg"
  fi

  install -Dm644 "${srcdir}/${_pkgsrc}/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  install -Dm644 "${srcdir}/${_pkgsrc}/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"

  if [[ -x "${_install_root}/Vesktop" ]]; then
    _app_exec="/opt/vesktop/Vesktop"
  fi

  sed -e "s#@VESKTOP_EXEC@#${_app_exec}#g" \
    "${srcdir}/vesktop-flags-wrapper.sh" >"${srcdir}/vesktop"

  if grep -q '@[A-Z_][A-Z_]*@' "${srcdir}/vesktop"; then
    printf '%s\n' "ERROR: unresolved wrapper placeholder(s):"
    grep -n '@[A-Z_][A-Z_]*@' "${srcdir}/vesktop"
    return 1
  fi

  install -Dm755 "${srcdir}/vesktop" "${pkgdir}/usr/bin/vesktop"

  for _file in "${_install_root}/vesktop" "${_install_root}/Vesktop"; do
    if [[ -x "${_file}" ]]; then
      _electron_version="$(strings "${_file}" | grep -Eom1 'Electron/[0-9.]+' || true)"
      [[ -n "${_electron_version}" ]] && break
    fi
  done

  _electron_version="${_electron_version#Electron/}"
  if [[ -n "${_electron_version}" ]]; then
    install -Dm644 /dev/stdin "${_install_root}/electron_version" <<<"${_electron_version}"
  fi

  chmod -R u=rwX,go=rX "${pkgdir}"
}
