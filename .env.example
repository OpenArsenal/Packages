# Copy this file to .env for machine-local overrides.
# The defaults below match the OpenArsenal production repository layout.

REPO_NAME=openarsenal
REPO_BASE=/srv/pacman/repos/openarsenal
REPO_ARCH=x86_64_v3
REPO_SIG_LEVEL="Optional TrustAll"

CHROOT_BASE=/var/lib/archbuild

PACKAGER="OpenArsenal Contributors <arch-packaging-team(at)openarsenal(dot)com>"
