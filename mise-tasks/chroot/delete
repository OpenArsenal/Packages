#!/usr/bin/env bash
#MISE description="Delete the configured build chroot (requires --force)"
#USAGE flag "--force" help="Confirm deletion of the configured chroot"

set -euo pipefail

[[ "${usage_force:-false}" == true ]] || { echo "Use --force to delete the build chroot." >&2; exit 1; }
chroot="$(realpath -m -- "${CHROOT_DIR:?CHROOT_DIR not set}")"
case "$chroot" in
  / | "$HOME" | "${PKGBUILDS_ROOT:?}" | "${CHROOT_BASE:?}")
    echo "error: Refusing to delete $chroot" >&2
    exit 1
    ;;
esac
[[ -d "$chroot/root" ]] || { echo "error: Not a build chroot: $chroot (missing root/)" >&2; exit 1; }

exec run0 rm -rf --one-file-system -- "$chroot"
