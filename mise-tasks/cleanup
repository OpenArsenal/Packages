#!/usr/bin/env bash
#MISE description="Preview ignored package/cache cleanup; use --force to delete"
#USAGE flag "--force" help="Delete the listed ignored artifacts instead of previewing"

set -euo pipefail

mode=--dry-run
[[ "${usage_force:-false}" == true ]] && mode=--force

# Scope cleanup so local credentials, signing keys, and new recipes are preserved.
exec git --no-pager -C "${PKGBUILDS_ROOT:?}" clean -dX "$mode" -- packages .cache
