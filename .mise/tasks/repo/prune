#!/usr/bin/env bash
#MISE description="Prune old versions and archives no longer indexed by the repository"
#USAGE flag "-q --quiet" help="Do not print removed orphan archive names"
#USAGE flag "-d --dry-run" help="Preview removals"
#USAGE arg "-k --keep <count>" help="Versions to keep per indexed package" default="2"
#USAGE arg "-a --min-atime <age>" help="Only remove old versions unused for this long" required=#false

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/repo.sh"

task::bootstrap
task::require_env REPO_DIR REPO_DB

# Missing or invalid repository metadata must not turn published archives into
# apparent orphans. Pruning requires a usable index before any deletion.
[[ -f "$REPO_DB" && -r "$REPO_DB" ]] || {
  echo "error: refusing to prune without a readable repository database: $REPO_DB" >&2
  exit 1
}

declare -A published=()
if [[ -e "$REPO_DB" ]]; then
  declare -A indexed=()

  records="$(repo::db_records "$REPO_DB")" || {
    echo "error: unable to read repository database: $REPO_DB" >&2
    exit 1
  }

  package_count=0 filename_count=0
  while IFS=$'\t' read -r kind first second; do
    case "$kind" in
      P)
        [[ -n "$first" ]] && indexed["$first"]=1
        ((package_count += 1))
        ;;
      F)
        [[ -n "$first" && "$first" != */* && "$first" == *.pkg.tar.* ]] || {
          echo "error: invalid published archive filename in: $REPO_DB" >&2
          exit 1
        }
        published["$first"]=1
        ((filename_count += 1))
        ;;
    esac
  done <<<"$records"

  (( package_count == filename_count )) || {
    echo "error: incomplete archive filenames in repository database: $REPO_DB" >&2
    exit 1
  }

  (( package_count > 0 )) || {
    echo "error: refusing to prune without indexed packages in: $REPO_DB" >&2
    exit 1
  }
fi

# The database records published archive *names*. When a published archive is
# a symlink, pruning its unindexed target would leave that published name
# dangling. Build the complete protected set before selecting or deleting
# anything, including intermediate symlinks in a multi-hop chain.
declare -A protected=()
for filename in "${!published[@]}"; do
  protected["$filename"]=1
done

repo_dir_real="$(cd -- "$REPO_DIR" && pwd -P)" || {
  echo "error: cannot resolve repository directory before pruning: $REPO_DIR" >&2
  exit 1
}

for filename in "${!published[@]}"; do
  link="$repo_dir_real/$filename"
  [[ -L "$link" ]] || continue

  # Walk each link rather than only protecting realpath's final target:
  # paccache can independently select an intermediate symlink for deletion.
  declare -A visited_links=()
  while [[ -L "$link" ]]; do
    if [[ -n "${visited_links[$link]+x}" ]]; then
      echo "error: published archive symlink loop: $repo_dir_real/$filename" >&2
      exit 1
    fi
    visited_links["$link"]=1
    destination="$(readlink -- "$link")" || {
      echo "error: cannot read published archive symlink: $link" >&2
      exit 1
    }
    [[ "$destination" == /* ]] || destination="$(dirname -- "$link")/$destination"
    parent="$(cd -- "$(dirname -- "$destination")" && pwd -P)" || {
      echo "error: cannot resolve published archive symlink: $link" >&2
      exit 1
    }
    if [[ "$parent" != "$repo_dir_real" ]]; then
      echo "error: published archive symlink escapes repository: $link" >&2
      exit 1
    fi
    link="$parent/$(basename -- "$destination")"
    protected["${link##*/}"]=1
  done

  resolved="$(realpath -e -- "$repo_dir_real/$filename")" || {
    echo "error: cannot resolve published archive symlink: $repo_dir_real/$filename" >&2
    exit 1
  }
  if [[ ! -f "$resolved" || "${resolved%/*}" != "$repo_dir_real" ]]; then
    echo "error: published archive symlink has no regular in-repository target: $repo_dir_real/$filename" >&2
    exit 1
  fi
done

args=(-d -v -c "$REPO_DIR" -k "${usage_keep:-2}")
[[ -n "${usage_min_atime:-}" ]] && args+=(--min-atime "${usage_min_atime}")
candidates="$(paccache "${args[@]}")" || {
  echo "error: unable to select archives for pruning" >&2
  exit 1
}

if [[ -e "$REPO_DB" ]]; then
  # An incomplete scan must never delete a subset of archives. Capture its
  # exit status before processing (a process substitution would hide it).
  archive_listing="$(mktemp)" || exit 1
  trap 'rm -f -- "$archive_listing"' EXIT
  if ! find "$REPO_DIR" -maxdepth 1 -type f -name '*.pkg.tar.*' ! -name '*.sig' -print0 >"$archive_listing"; then
    echo "error: unable to enumerate repository archives in: $REPO_DIR" >&2
    exit 1
  fi

  while IFS= read -r -d '' archive; do
    [[ -n "${protected[${archive##*/}]+x}" ]] && continue

    meta="$(pacman -Qp -- "$archive" 2>/dev/null)" || {
      echo "warning: unable to inspect package archive: $archive" >&2
      continue
    }

    pkg_name="${meta%% *}"
    [[ -n "${indexed[$pkg_name]+x}" ]] && continue

    if [[ "${usage_dry_run:-false}" == "true" ]]; then
      printf '%s\n' "$archive"
      [[ -f "$archive.sig" ]] && printf '%s\n' "$archive.sig"
      continue
    fi

    [[ "${usage_quiet:-false}" == "true" ]] || echo "Removing unindexed archive: $archive"
    rm -f -- "$archive" "$archive.sig" || exit 1
  done <"$archive_listing"
fi

while IFS= read -r filename; do
  [[ "$filename" == *.pkg.tar.* && "$filename" != *.sig && "$filename" != */* ]] || continue
  [[ -n "${protected[$filename]+x}" ]] && continue
  archive="$REPO_DIR/$filename"
  [[ -f "$archive" ]] || continue

  if [[ "${usage_dry_run:-false}" == "true" ]]; then
    printf '%s\n' "$archive"
    [[ -f "$archive.sig" ]] && printf '%s\n' "$archive.sig"
    continue
  fi

  [[ "${usage_quiet:-false}" == "true" ]] || echo "Removing old archive: $archive"
  rm -f -- "$archive" "$archive.sig" || exit 1
done <<<"$candidates"
