#!/usr/bin/env bash
#MISE description="Prune old package archives"
#USAGE flag "-u --uninstalled" help="Apply uninstalled-package retention rules"
#USAGE flag "-q --quiet" help="Do not print removed file names"
#USAGE flag "-d --dry-run" help="Preview removals"
#USAGE arg "-k --keep <count>" help="Versions to keep per package" default="2"
#USAGE arg "-a --min-atime <age>" help="Only remove files unused for this long" required=#false

set -euo pipefail

: "${REPO_DIR:?REPO_DIR not set}"

args=(-c "$REPO_DIR" -k "${usage_keep:-2}")

if [[ "${usage_dry_run:-false}" == "true" ]]; then
  args+=(-d)
else
  args+=(-r)
fi

[[ "${usage_uninstalled:-false}" == "true" ]] && args+=(-u)
[[ "${usage_quiet:-false}" == "true" ]] && args+=(-q)
[[ -n "${usage_min_atime:-}" ]] && args+=(--min-atime "${usage_min_atime}")

paccache "${args[@]}"
