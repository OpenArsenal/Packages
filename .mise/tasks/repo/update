#!/usr/bin/env bash
#MISE description="Update the repository database"
#USAGE flag "--new" help="Only add packages not already present"
#USAGE flag "--prevent-downgrade" help="Skip if a newer version already exists"
#USAGE flag "--include-sigs" help="Include package signatures"
#USAGE flag "--refresh-sync" help="Refresh the host pacman sync database"
#USAGE flag "-d --dry-run" help="Print selected package archives without changing the database"
#USAGE arg "[package]" help="Package name, archive path, or glob"

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/repo.sh"

task::bootstrap
task::require_env REPO_DIR REPO_DB

repo::update_db \
  "$REPO_DIR" \
  "$REPO_DB" \
  "${usage_package:-}" \
  "${usage_new:-false}" \
  "${usage_prevent_downgrade:-false}" \
  "${usage_include_sigs:-false}" \
  "${usage_dry_run:-false}"

if [[ "${usage_refresh_sync:-false}" == "true" && "${usage_dry_run:-false}" != "true" ]]; then
  task::require_env REPO_NAME
  repo::refresh_sync_db "$REPO_NAME"
fi
