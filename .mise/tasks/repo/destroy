#!/usr/bin/env bash
#MISE description="Remove the configured repository directory"
#MISE confirm={ message = "Delete the configured repository directory?", default = "no" }

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"

task::bootstrap
task::require_env REPO_DIR PKGBUILDS_ROOT

case "$REPO_DIR" in
  "" | "/" | "." | "$PKGBUILDS_ROOT")
    echo "error: refusing to delete REPO_DIR=$REPO_DIR" >&2
    exit 1
    ;;
esac

rm -rf -- "$REPO_DIR"
