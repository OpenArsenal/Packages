#!/usr/bin/env bash
#MISE description="Add a user to the repository group"
#USAGE arg "[user]" help="User to add (defaults to $USER)"

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/repo.sh"

task::bootstrap

REPO_GROUP="${REPO_GROUP:-${REPO_NAME:-}}"
TARGET_USER="${usage_user:-${USER:-}}"

task::require_env REPO_GROUP TARGET_USER

repo::ensure_group "$REPO_GROUP"
repo::add_user_to_group "$TARGET_USER" "$REPO_GROUP"

echo "OK. Group entry:"
getent group "$REPO_GROUP" || true
