#!/usr/bin/env bash
#MISE description="Destroy the clean package-build chroot"
#MISE hide=true

set -euo pipefail

: "${CHROOT_DIR:?CHROOT_DIR not set}"

case "$CHROOT_DIR" in
  "/" | "." | "")
    echo "error: refusing to delete CHROOT_DIR=$CHROOT_DIR" >&2
    exit 1
    ;;
esac

run0 rm -rf -- "$CHROOT_DIR"
