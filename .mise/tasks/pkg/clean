#!/usr/bin/env bash
#MISE description="Preview or remove package build logs"
#MISE alias="clean"
#USAGE flag "-f --force" help="Remove package build logs instead of only previewing"

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"

task::bootstrap
task::require_env PACKAGES_DIR

# A process substitution hides a failed find (and may report a partial list).
# Finish discovery successfully before deleting any log directory.
log_listing="$(mktemp)" || exit 1
if ! find "$PACKAGES_DIR" -mindepth 2 -maxdepth 2 -type d -name logs -print0 >"$log_listing"; then
  rm -f -- "$log_listing"
  echo "error: unable to enumerate package build logs in: $PACKAGES_DIR" >&2
  exit 1
fi
mapfile -d '' -t logs <"$log_listing"
rm -f -- "$log_listing"

if [[ "${#logs[@]}" -eq 0 ]]; then
  echo "No package build logs found."
  exit 0
fi

printf '%s
' "${logs[@]}"

if [[ "${usage_force:-false}" == "true" ]]; then
  rm -rf -- "${logs[@]}"
else
  echo "Preview only. Re-run with --force to remove these log directories."
fi
