#!/usr/bin/env bash
#MISE description="Build packages from PACKAGES_FILE and their local dependencies"
#USAGE flag "--force" help="Rebuild explicitly selected packages even if the same version is already published"

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/repo.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/chroot.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/pkg.sh"

task::bootstrap
task::require_env PACKAGES_DIR PACKAGES_FILE REPO_DIR REPO_DB CHROOT_DIR

declare -a requested=()
pkg::load_requested "$PACKAGES_FILE" requested

[[ "${#requested[@]}" -gt 0 ]] || {
  echo "No packages listed in $PACKAGES_FILE" >&2
  exit 1
}

# Planning can fail on an invalid selection or dependency before any
# setup; empty plans must not invoke privileged provisioning either.
pkg::plan_selected "$PACKAGES_DIR" "${usage_force:-false}" "${requested[@]}"
if (( ${#PKG_PLAN[@]} == 0 )); then
  echo "No packages need building."
  exit 0
fi

mise run repo:create
mise run chroot:create
pkg::build_plan
