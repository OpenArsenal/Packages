#!/usr/bin/env bash
#MISE description="Build packages listed in .packages, including local build dependencies"
#MISE depends=["repo:create", "chroot:create"]
#MISE depends_post=["repo:update"]

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/repo.sh"
source "${PKGBUILDS_ROOT}/.mise/lib/pkg.sh"

task::bootstrap
task::require_env REPO_DIR REPO_DB CHROOT_DIR PKG_DIR

PACKAGES_FILE="${PACKAGES_FILE:-${PKGBUILDS_ROOT}/.packages}"
PACKAGES_DIR="${PACKAGES_DIR:-${PKG_DIR}}"

declare -a requested=()
pkg::load_requested "$PACKAGES_FILE" requested

if [[ "${#requested[@]}" -eq 0 ]]; then
  echo "No packages listed in $PACKAGES_FILE" >&2
  exit 1
fi

echo "Building ${#requested[@]} requested package(s) from $PACKAGES_FILE" >&2
pkg::build_selected "$PACKAGES_DIR" "${requested[@]}"
