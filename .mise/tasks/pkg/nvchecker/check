#!/usr/bin/env bash
#MISE description="Validate nvchecker config coverage and pkgctl compatibility"

source "${PKGBUILDS_ROOT}/.mise/lib/task.sh"

task::bootstrap
task::require_env SCRIPTS FEEDS_JSON PACKAGES_DIR

python3 "$SCRIPTS/format-nvchecker.py" \
  --packages-dir "$PACKAGES_DIR" \
  --check \
  --quiet

python3 "$SCRIPTS/generate-nvchecker.py" \
  --feeds "$FEEDS_JSON" \
  --packages-dir "$PACKAGES_DIR" \
  --dry-run \
  --strict \
  --quiet
