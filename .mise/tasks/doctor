#!/usr/bin/env bash
#MISE description="Check tools used by the package workflows"

set -euo pipefail

tools=(
  bash
  bsdtar
  curl
  git
  gpg
  jq
  makechrootpkg
  makepkg
  mkarchroot
  paccache
  pacman
  pacman-conf
  python3
  repo-add
  run0
  vercmp
)

missing=0
for tool in "${tools[@]}"; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'Missing: %s\n' "$tool"
    missing=1
  fi
done

(( missing == 0 )) || exit 1
echo "OK"
