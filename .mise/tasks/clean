#!/usr/bin/env bash
#MISE description="Preview or remove ignored build artifacts"
#USAGE flag "-f --force" help="Remove ignored artifacts instead of only previewing"

set -euo pipefail

if [[ "${usage_force:-false}" == "true" ]]; then
  git clean -fdX
else
  git clean -ndX
  echo "Preview only. Re-run with --force to remove these ignored files."
fi
